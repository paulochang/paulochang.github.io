<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or title }}">
  <title>{% if title %}{{ title }} | {% endif %}Paulo Chang</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --bg: #f5f5f4;
      --surface: #ffffff;
      --text: #1c1917;
      --text-muted: #78716c;
      --accent: #292524;
      --border: #e7e5e4;
      --link: #1d4ed8;
      --link-visited: #7e22ce;
      --code-bg: #f1f0ef;
      --max-width: 48rem;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #1c1917;
        --surface: #292524;
        --text: #f5f5f4;
        --text-muted: #a8a29e;
        --accent: #e7e5e4;
        --border: #44403c;
        --link: #93c5fd;
        --link-visited: #c4b5fd;
        --code-bg: #292524;
      }
    }

    html {
      font-size: 16px;
      font-family: Georgia, "Times New Roman", Times, serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
    }

    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }

    header .inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    header a {
      color: var(--text);
      text-decoration: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    header .site-name {
      font-weight: 600;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
    }

    header nav a {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.15s;
    }

    header nav a:hover { color: var(--text); }

    main {
      flex: 1;
      max-width: var(--max-width);
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }

    footer {
      border-top: 1px solid var(--border);
      background: var(--surface);
      text-align: center;
      padding: 1.25rem 1.5rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.825rem;
      color: var(--text-muted);
    }

    footer a {
      color: var(--text-muted);
      text-decoration: none;
    }

    footer a:hover { color: var(--text); }

    a { color: var(--link); }
    a:visited { color: var(--link-visited); }

    h1, h2, h3 {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.25;
      color: var(--text);
      font-weight: 700;
    }

    h1 { font-size: 2rem; margin: 0 0 1.5rem; letter-spacing: -0.02em; }
    h2 { font-size: 1.4rem; margin: 2.5rem 0 0.75rem; }
    h3 { font-size: 1.15rem; margin: 2rem 0 0.5rem; }

    p { margin: 0 0 1.25rem; }

    code {
      font-family: ui-monospace, "SF Mono", Menlo, Monaco, "Cascadia Code", monospace;
      font-size: 0.875em;
      background: var(--code-bg);
      padding: 0.15em 0.4em;
      border-radius: 3px;
    }

    pre {
      background: var(--code-bg);
      padding: 1.25rem;
      border-radius: 6px;
      overflow-x: auto;
      margin: 0 0 1.25rem;
    }

    pre code {
      background: none;
      padding: 0;
      font-size: 0.875rem;
    }

    blockquote {
      border-left: 3px solid var(--border);
      margin: 1.5rem 0;
      padding: 0.25rem 0 0.25rem 1.25rem;
      color: var(--text-muted);
    }

    hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    ul, ol {
      padding-left: 1.5rem;
      margin: 0 0 1.25rem;
    }

    li { margin-bottom: 0.3rem; }

    img {
      max-width: 100%;
      height: auto;
      border-radius: 4px;
    }

    .post-meta {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
    }

    .post-list { list-style: none; padding: 0; margin: 0; }

    .post-item {
      padding: 1.75rem 0;
      border-bottom: 1px solid var(--border);
    }

    .post-item:first-child { padding-top: 0.25rem; }

    .post-item h2 {
      font-size: 1.2rem;
      margin: 0 0 0.35rem;
      font-weight: 600;
    }

    .post-item h2 a {
      color: var(--text);
      text-decoration: none;
    }

    .post-item h2 a:hover { color: var(--link); }

    .post-item .date {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }

    .post-item .excerpt {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin: 0;
    }

    .pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2.5rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 0.9rem;
      gap: 1rem;
    }

    .pagination a {
      color: var(--link);
      text-decoration: none;
      padding: 0.4rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--surface);
    }

    .pagination a:hover { border-color: var(--link); }

    .pagination .page-info { color: var(--text-muted); }

    .page-title {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 1.5rem;
      font-weight: 700;
      margin: 0 0 2rem;
      letter-spacing: -0.02em;
    }

    @media (max-width: 600px) {
      h1 { font-size: 1.6rem; }
      .page-title { font-size: 1.25rem; }
      main { padding: 1.75rem 1.25rem 3rem; }
    }
  </style>
</head>
<body>
  <header>
    <div class="inner">
      <a class="site-name" href="/">Paulo Chang</a>
      <nav><a href="/blog/">Blog</a></nav>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <a href="/">paulochang.github.io</a>
  </footer>
</body>
</html>
