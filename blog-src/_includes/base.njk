{%- set canonical = site.origin + page.url -%}
{%- set pageSuffix = (", page " + (pagination.pageNumber + 1)) if pagination.pageNumber else "" -%}
{%- set pageDescription = metaDescription or description -%}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{{ pageSuffix }} &mdash; Paulo Chang</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="Paulo Chang">
  <link rel="canonical" href="{{ canonical }}">
{%- if pagination.href.previous %}
  <link rel="prev" href="{{ site.origin }}{{ pagination.href.previous }}">
{%- endif %}
{%- if pagination.href.next %}
  <link rel="next" href="{{ site.origin }}{{ pagination.href.next }}">
{%- endif %}

  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="Paulo Chang">
  <meta property="og:title" content="{{ title }}{{ pageSuffix }} &mdash; Paulo Chang">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:image" content="{{ site.origin }}/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Paulo Chang, senior backend engineer and Backend Community AI Champion">
  <meta name="twitter:card" content="summary_large_image">
{%- if ogType == "article" and postDate %}
  <meta property="article:published_time" content="{{ postDate | isoDate }}">
{%- endif %}

  <link rel="icon" href="/img/favicon.ico" type="image/x-icon">
  <link rel="alternate" type="text/markdown" href="{{ mdHref or (canonical + 'index.md') }}">
  <link rel="alternate" type="application/atom+xml" title="Paulo Chang: Blog" href="{{ site.blogBase }}feed.xml">
  <style>{{ siteCss | safe }}
/* Post typography, modelled on Medium's published article view:
   680px column, 20/32 serif body, 600-weight sans headings close to their text.
   The column, page title and h2/h3 base styles come from the shared site CSS above. */
header.post-header{padding-bottom:0}
header.post-header #lede{margin-top:2rem;font-size:.875rem;line-height:1.75}
main.post{padding-top:2.5rem}
.post-body{font-size:1.25rem;line-height:1.6;letter-spacing:-.003em;color:var(--ink)}
.post-body p,.post-body li{font-size:inherit;margin-bottom:0;text-wrap:pretty}
.post-body>*+*{margin-top:1.7em}
.post-body>:first-child{margin-top:0}
.post-body :is(h2,h3,h4,h5,h6){font-family:var(--sans);font-weight:600;font-style:normal;text-wrap:balance}
.post-body h2{margin:1.75em 0 0}
.post-body h3{font-size:1.25rem;line-height:1.2;margin:1.25em 0 0}
.post-body h4,.post-body h5,.post-body h6{font-size:1.25rem;line-height:1.2;margin:1.25em 0 0}
.post-body>:is(h2,h3,h4,h5,h6)+*{margin-top:.6rem}
.post-body ul,.post-body ol{padding-left:1.5em}
.post-body ul{list-style:disc}
.post-body ol{list-style:decimal}
.post-body li+li,.post-body li>ul,.post-body li>ol{margin-top:.7em}
.post-body li::marker{color:var(--ink)}
.post-body pre{overflow-x:auto;padding:2rem;background:#f0f0ec;border:1px solid var(--rule);border-radius:4px;font-size:.875rem;line-height:1.4;letter-spacing:0}
.post-body code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
.post-body :not(pre)>code{font-size:.75em;background:#ebebe6;padding:2px 4px}
.post-body blockquote{font-style:italic;padding-left:20px;box-shadow:inset 3px 0 0 var(--ink)}
.post-body img{max-width:100%;height:auto}
.post-body hr{border:0;text-align:center;margin:2.5em 0;height:auto}
.post-body hr::before{content:"\2026";font-size:1.5rem;letter-spacing:.6em;color:var(--ink)}
.post-body table{display:block;overflow-x:auto;border-collapse:collapse;font-size:1rem}
.post-body th,.post-body td{padding:.4em .8em;border:1px solid var(--rule);text-align:left}
.post-body th{font-weight:600}
.post-back{font-family:var(--sans)}
@media (min-width:768px){.post-body blockquote{margin-left:-20px;padding-left:23px}}
@media (max-width:728px){
header.post-header #lede{margin-top:1.5rem}
.post-body{font-size:1.125rem;line-height:1.556}
.post-body>*+*{margin-top:1.1em}
.post-body h2{margin-top:2em}
.post-body h3,.post-body h4,.post-body h5,.post-body h6{font-size:1rem}
.post-body>:is(h2,h3,h4,h5,h6)+*{margin-top:.4rem}
}
.post-meta{font-size:.9rem;color:var(--ink-soft)}
.draft-label{font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--ink-soft);padding:.1em .5em;margin-left:.5em}
.pager{display:flex;justify-content:space-between;gap:1em;margin-top:3rem;font-size:.9rem}
.post-back{margin-top:3rem;font-size:.9rem}
</style>
{%- if jsonldData %}

  <script type="application/ld+json">{{ jsonldData | jsonLd | safe }}</script>
{%- endif %}
</head>

<body>
  <a id="skip-link" href="#main">Skip to main content</a>

  <nav aria-label="Primary">
    <a href="/">Paulo Chang</a>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/projects/">Projects</a></li>
      <li><a href="/resume/">Resume</a></li>
      <li><a href="/blog/" aria-current="{{ 'page' if navCurrent == 'list' else 'true' }}">Blog</a></li>
    </ul>
  </nav>

{{ content | safe }}

  <footer>
    <p>
      <a href="https://github.com/paulochang">GitHub</a> &middot;
      <a href="https://www.linkedin.com/in/paulochang">LinkedIn</a> &middot;
      <a href="/blog/feed.xml">Feed</a>
    </p>
  </footer>
</body>

</html>
