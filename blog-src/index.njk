---
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "{% if pagination.pageNumber === 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "{% if pagination.pageNumber === 0 %}Blog{% else %}Blog — Page {{ pagination.pageNumber + 1 }}{% endif %}"
---
<h1 class="page-title">{% if pagination.pageNumber === 0 %}Writing{% else %}Writing — Page {{ pagination.pageNumber + 1 }}{% endif %}</h1>
<ul class="post-list">
  {% for post in posts %}
  <li class="post-item">
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <div class="date">{{ post.date | dateFormat }}</div>
    <p class="excerpt">{{ post | excerpt }}</p>
  </li>
  {% endfor %}
</ul>
{% if pagination.href.previous or pagination.href.next %}
<nav class="pagination" aria-label="Pagination">
  <span>
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">&larr; Newer</a>
    {% endif %}
  </span>
  <span class="page-info">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</span>
  <span>
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">Older &rarr;</a>
    {% endif %}
  </span>
</nav>
{% endif %}
